{
  "includeCoAuthoredBy": false,
  "disableClaudeAiConnectors": false,
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/status-line.sh"
  },
  "permissions": {
    "allow": [
      "Bash(basename *)",
      "Bash(cargo check:*)",
      "Bash(cargo build:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo fix:*)",
      "Bash(cargo info:*)",
      "Bash(cargo metadata:*)",
      "Bash(cargo rustc:*)",
      "Bash(cargo rustdoc:*)",
      "Bash(cargo search:*)",
      "Bash(cargo test:*)",
      "Bash(cargo tree:*)",
      "Bash(date *)",
      "Bash(df *)",
      "Bash(diff *)",
      "Bash(dirname *)",
      "Bash(du *)",
      "Bash(file *)",
      "Bash(find:*)",
      "Bash(git diff:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(du *)",
      "Bash(ls:*)",
      "Bash(md5 *)",
      "Bash(mkdir:*)",
      "Bash(pnpm audit:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm test:*)",
      "Bash(pnpm why:*)",
      "Bash(readlink *)",
      "Bash(realpath *)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(stat *)",
      "Bash(tree *)",
      "Bash(tail:*)"
    ],
    "deny": [
      "Bash(cargo owner:*)",
      "Bash(cargo publish:*)",
      "Bash(cargo yank:*)",
      "Bash(dd *)",
      "Bash(diskutil *)",
      "Bash(mkfs *)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf /* *)",
      "Bash(rm -rf ~ *)",
      "Bash(rm -rf $HOME *)",
      "Bash(sudo rm -rf / *)",
      "Bash(sudo rm -rf /* *)",
      "Read(//**/.aws/**)",
      "Read(//**/.terraform/**)",
      "Read(./config/credentials.json)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)"
    ],
    "ask": [
      "Bash(cargo add:*)",
      "Bash(cargo install:*)",
      "Bash(cargo login:*)",
      "Bash(cargo logout:*)",
      "Bash(cargo remove:*)",
      "Bash(cargo uninstall:*)",
      "Bash(cargo update:*)",
      "Bash(docker push *)",
      "Bash(gh pr merge *)",
      "Bash(git push:*)",
      "Bash(npm publish *)",
      "Bash(rm:*)"
    ]
  },
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/needs-permission.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify-ready.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "explanatory-output-style@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  }
}
